# ==============================================
# HopeAlong Server Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values

PORT=5000
NODE_ENV=development

# Frontend URL - Update based on deployment
# Local: http://localhost:5173
# Production: https://hopealong.vercel.app
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hopeAlong?retryWrites=true&w=majority&appName=Cluster0

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Callback URL - Update based on deployment
# Local: http://localhost:5000/api/auth/google/callback
# Production: https://hopealongl21.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

JWT_SECRET=your-super-secret-jwt-key

GOOGLE_MAPS_API_KEY=your-google-maps-api-key

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
